<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WPods.ico</ApplicationIcon>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- DPI awareness is declared in app.manifest (process-wide, before any code) and also set via SetHighDpiMode. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Size: no package XML docs; WebView2Loader.dll only once (NuGet win-x64 asset in the app root). -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PairsideLive)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Pairside</AssemblyName>
    <RootNamespace>WPods</RootNamespace>
    <Product>Parity</Product>
    <AssemblyTitle>Parity</AssemblyTitle>
    <Version>0.19.2</Version>
    <Description>AirPods control for Windows</Description>
    <ApplicationIcon>../Pairside/Pairside.ico</ApplicationIcon>
    <ApplicationManifest>../Pairside/app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);PAIRSIDE_LIVE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../BluetoothServiceIdentity.cs" Link="BluetoothServiceIdentity.cs" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" Condition="'$(PairsideLive)' == 'true'" />
    <EmbeddedResource Include="Audio\kemar48.bin" LogicalName="Pairside.Kemar48" Condition="'$(PairsideLive)' == 'true'" />
    <EmbeddedResource Include="../Pairside/Pairside.ico" LogicalName="Pairside.ico" Condition="'$(PairsideLive)' == 'true'" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <PropertyGroup Condition="'$(PairsideLive)' == 'true' and '$(ParityOwnerPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);PARITY_OWNER_PREVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PairsideLive)' == 'true' and '$(ParityOwnerPreview)' == 'true'">
    <Compile Include="../../tools/headphone-level/AcousticCalibration.cs" Link="Audio/AcousticCalibration.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(PairsideLive)' != 'true'">
    <Content Include="..\..\.build\native\bin\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.build\native\bin\DeepFilterNet3_onnx.tar.gz" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Mic mode models, downloaded (native\fetch-models.ps1) -->
    <Content Include="..\..\.build\native\bin\models\dpdfnet2_48khz_hr.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.build\native\bin\models\dpdfnet8_48khz_hr.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.build\native\bin\models\fastenhancer48k_t.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.build\native\bin\models\fastenhancer48k_b.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.build\native\bin\models\fastenhancer48k_s.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.build\native\bin\models\fastenhancer48k_m.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.build\native\bin\models\fastenhancer48k_l.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.build\native\bin\models\fevd_gtcrn_spec.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.build\native\bin\models\gtcrn_simple.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Exported (native\export-models.ps1, run by build.ps1 when missing) -->
    <Content Include="..\..\.build\native\bin\models\nsnet2_48k.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="web\**" CopyToOutputDirectory="PreserveNewest" Condition="'$(ParityPackageWeb)' == ''" />
    <Content Include="$(ParityPackageWeb)\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="'$(ParityPackageWeb)' != ''" />
    <None Remove="web\**" />
    <Content Include="locales\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The WebView2 package also references its WPF control; WPods only uses WinForms. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
